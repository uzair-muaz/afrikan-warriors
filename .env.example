# Copy to .env.local. Do not commit secrets.

# Local default. On Vercel set this to https://afrikanwarriors.com
# Share cards and canonical links use that production address.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Web Analytics beacon. Public site token (it is visible in the
# page source). Same value on Vercel production. See docs/cloudflare.md.
# Leave automatic injection OFF in Cloudflare, or each visit is counted twice.
NEXT_PUBLIC_CLOUDFLARE_BEACON_TOKEN=9af837a0c08b483b8901fc7ad6e1bb15

# Stripe (Dashboard → Developers → API keys / Webhooks)
# Webhook URL: /api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed
# Local: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL="Afrikan Warriors <booking@afrikanwarriors.com>"

# Where emails land. Comma-separated for multiple inboxes.
# Booking / enquiry / shop-interest forms:
NOTIFY_EMAIL=booking@afrikanwarriors.com, team@example.com
# Support + shop payment notices (falls back to NOTIFY_EMAIL if empty):
PAYMENTS_NOTIFY_EMAIL=booking@afrikanwarriors.com, finance@example.com

# Shop (set true after product prices + shipping pence are set)
SHOP_LIVE=false
SHIPPING_UK_STANDARD_PENCE=
SHIPPING_UK_EXPRESS_PENCE=
SHIPPING_INTERNATIONAL_PENCE=
